# ------------------------------
# Global ignores
# ------------------------------
.DS_Store
Thumbs.db

# Environment files
.env
.env.*
!frontend/.env.example
!backend/.env.example

# ------------------------------
# Dependencies
# ------------------------------
node_modules/

# ------------------------------
# Build output
# ------------------------------
dist/
www/
build/

# ------------------------------
# Frontend (Angular / Ionic)
# ------------------------------
frontend/dist/
frontend/www/

# ------------------------------
# Backend
# ------------------------------
backend/dist/
backend/build/
backend/.env
backend/prisma/*.db
backend/prisma/migrations/

# ------------------------------
# Logs
# ------------------------------
*.log
npm-debug.log*
yarn-debug.log*
