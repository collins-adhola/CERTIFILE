# ------------------------------
# Global ignores
# ------------------------------
.DS_Store
Thumbs.db
.env
.env.local
.env.production
.env.development

# ------------------------------
# Node modules (frontend & backend)
# ------------------------------
frontend/node_modules/
backend/node_modules/

# ------------------------------
# Build output (Angular/Ionic)
# ------------------------------
frontend/www/
frontend/dist/
frontend/build/

# ------------------------------
# Logs
# ------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------
# Editor/IDE files
# ------------------------------
.vscode/
.idea/
*.swp

# ------------------------------
# Backend environment & prisma
# ------------------------------
backend/.env
backend/prisma/*.db
backend/prisma/migrations/

# ------------------------------
# Backend build artifacts (if you build later)
# ------------------------------
backend/dist/
backend/build/

# ------------------------------
# Misc
# ------------------------------
*.log
