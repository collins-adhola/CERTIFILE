# Core Intake API v3.0 - Environment Variables
#
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control!

# Server Configuration
# Port number for the API server (default: 5050)
PORT=5050

# Supabase Configuration
# Your Supabase project URL (found in Supabase dashboard > Settings > API)
# Format: https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key
# WARNING: This is a secret key with full database access. Never expose it to the frontend!
# Found in Supabase dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# CORS Configuration
# Comma-separated list of allowed origins (e.g., "http://localhost:8100,https://yourdomain.com")
CORS_ORIGIN=http://localhost:8100,https://www.certifile.co.uk

# Environment
# Set to "production" for production deployments
NODE_ENV=development

# Admin Authorization (v3.0)
# Comma-separated list of admin email addresses allowed to access admin endpoints
# Example: admin@certifile.co.uk,admin2@certifile.co.uk
ADMIN_EMAIL_ALLOWLIST=admin@certifile.co.uk

# Admin Authentication (v2.0 - DEPRECATED in v3.0, kept for backward compatibility)
# Admin email address for login
ADMIN_EMAIL=admin@certifile.co.uk

# Admin password hash (bcrypt)
# Generate using: node -e "console.log(require('bcryptjs').hashSync('your_password', 10))"
ADMIN_PASSWORD_HASH=

# JWT Configuration (v2.0 - DEPRECATED in v3.0)
# Secret key for signing JWT tokens (use a long, random string in production)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# JWT token expiration time (e.g., "12h", "7d", "30d")
JWT_EXPIRES_IN=12h

# Legacy Admin Key (v1.0 - deprecated, kept for backward compatibility during migration)
# This is no longer used in v2.0 but kept for reference
# ADMIN_KEY=change_me_to_a_strong_random_string
